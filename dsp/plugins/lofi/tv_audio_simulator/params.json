{
  "type": "TVAudioSimulatorPlugin",
  "tolerance": { "abs": 0.0001, "policy": "per-sample" },
  "fields": [
    { "name": "broadcast", "key": "rd", "kind": "bool", "step": 1, "default": true, "automation": true },
    { "name": "standard", "key": "ss", "kind": "enum", "step": 1, "default": "M/EIA-J", "values": ["M/EIA-J", "M/BTSC", "M/A2", "B/G A2", "B/G NICAM", "I NICAM", "D/K Mono", "L AM"], "automation": true },
    { "name": "txMode", "key": "tx", "kind": "enum", "step": 1, "default": "Stereo", "values": ["Stereo", "Mono", "Dual"], "automation": true },
    { "name": "processing", "key": "pr", "kind": "float", "min": 0, "max": 18, "step": 0.1, "default": 0, "unit": "dB", "automation": true },
    { "name": "signal", "key": "st", "kind": "float", "min": 0, "max": 70, "step": 0.1, "default": 35, "unit": "dBuV", "automation": true },
    { "name": "tuning", "key": "tn", "kind": "float", "min": -200, "max": 200, "step": 0.1, "default": 0, "unit": "kHz", "automation": true },
    { "name": "ifBand", "key": "bw", "kind": "float", "min": 80, "max": 240, "step": 1, "default": 230, "unit": "kHz", "publicName": "ifBandwidth", "automation": true },
    { "name": "multipath", "key": "mp", "kind": "float", "min": 0, "max": 100, "step": 1, "default": 0, "unit": "%", "automation": true },
    { "name": "pathDelay", "key": "dl", "kind": "float", "min": 0.5, "max": 50, "step": 0.01, "default": 5, "unit": "us", "automation": { "normalization": "log" } },
    { "name": "fading", "key": "fd", "kind": "float", "min": 0, "max": 20, "step": 0.1, "default": 0, "unit": "Hz", "automation": true },
    { "name": "receiveMode", "key": "sm", "kind": "enum", "step": 1, "default": "Auto", "values": ["Auto", "Stereo", "Main", "Sub"], "automation": true },
    { "name": "buzz", "key": "bz", "kind": "float", "min": -80, "max": -20, "step": 1, "default": -80, "unit": "dB", "automation": true },
    { "name": "outputGain", "key": "og", "kind": "float", "min": -24, "max": 24, "step": 0.1, "default": 0, "unit": "dB", "automation": true },
    { "name": "mix", "key": "mx", "kind": "float", "min": 0, "max": 100, "step": 1, "default": 100, "unit": "%", "automation": true }
  ]
}
